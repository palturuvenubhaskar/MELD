# MELD environment template.
# Copy to .env and fill in real values locally. .env is gitignored.
# Never commit credentials, never send provider secrets to the frontend.

# --- PostgreSQL 16 (native local service) ----------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meld
DB_NAME_TEST=meld_test
DB_USER=meld
DB_PASSWORD=changeme
DATABASE_URL=jdbc:postgresql://localhost:5432/meld
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/meld_test

# --- Spring ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# --- Provider credential encryption ---------------------------------------
# AES-256-GCM key: 32 random bytes, base64-encoded, kept outside the database
# and outside git. Generate with: openssl rand -base64 32
MELD_CREDENTIAL_ENCRYPTION_KEY=

# --- Provider endpoints (optional overrides for gateways / local stubs) ----
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Limits (see PRD.md section 13 - still to be decided) -----------------
# Per-node execution timeout, model token cap, max tool calls per execution,
# per-workspace concurrent execution limit.
